# --- Required -----------------------------------------------------------
# Apify (LinkedIn scraper) — https://console.apify.com/settings/integrations
APIFY_API_TOKEN=
# Only for linkedin `mode: cookies` (off by default): browser user agent; cookies in secrets/linkedin_cookies.json
# LINKEDIN_USER_AGENT=
# OpenRouter (free models) — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Comma-separated, first = primary; the rest are fallbacks. Must be ":free" models.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
# Job scoring only: tried first, then OPENROUTER_MODEL as fallbacks.
OPENROUTER_SCORING_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Google (via gws). Written by scripts/google_setup.py — see GWS_SETUP.md
GOOGLE_RESUME_TEMPLATE_ID=
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# --- Daily tracker email after each run (sent from your Gmail via gws; needs the gmail.send login scope)
REPORT_EMAIL_TO=

# --- Optional phone alerts (off: alerts are desktop pop-ups via scripts/sync_desktop.py)
# NTFY_TOPIC=
# GWS_CREDENTIALS_JSON is NOT set here — push_modal_secrets.py reads the local gws login directly.

# --- Optional: Telegram summary + failure alerts (GWS_SETUP.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
